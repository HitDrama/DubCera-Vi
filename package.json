{
  "name": "dubcera-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @dubcera/core test",
    "typecheck": "pnpm -r typecheck",
    "dev:extension": "pnpm --filter @dubcera/extension dev",
    "build:extension": "pnpm --filter @dubcera/extension build"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@vitejs/plugin-react": "^4.4.1"
    }
  }
}
